# Client-side Supabase configuration (safe to expose in browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-side only. Never put this in VITE_* variables or commit it.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional Design Arena database wake-up integration. Leave empty if unused.
FULLSTACK_PROJECT_REF=
FULLSTACK_RESTORE_API_URL=
